  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6a688a",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings, Constants",
      "scope": [
        "string",
        "constant"
      ],
      "settings": {
        "foreground": "#B464A4"
      }
    },
    {
      "name": "Keywords, Storage Types",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#a29bfe",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Classes, Types, Structs",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "support.class"
      ],
      "settings": {
        "foreground": "#7dd3fc",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Functions & Methods",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#7dd3fc"
      }
    },
    {
      "name": "Primitive Types",
      "scope": [
        "support.type.primitive",
        "support.type.primitive.ts",
        "support.type.builtin",
        "support.type.builtin.ts"
      ],
      "settings": {
        "foreground": "#7dd3fc"
      }
    },
    {
      "name": "Object Keys, Property Names",
      "scope": [
        "meta.object-literal.key",
        "support.type.property-name",
        "variable.other.property",
        "variable.other.object.property"
      ],
      "settings": {
        "foreground": "#a29bfe"
      }
    },
    {
      "name": "Variables & Parameters",
      "scope": [
        "variable"
      ],
      "settings": {
        "foreground": "#e5e0ff"
      }
    },
    {
      "name": "Variable Parameters",
      "scope": "variable.parameter",
      "settings": {
        "foreground": "#e5e0ff",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Punctuation - General",
      "scope": "punctuation",
      "settings": {
        "foreground": "#6a688a"
      }
    },
    {
      "name": "Punctuation - Accessors",
      "scope": [
        "punctuation.accessor",
        "punctuation.separator.dot",
        "punctuation.separator.namespace"
      ],
      "settings": {
        "foreground": "#e5e0ff"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#a29bfe"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#9a98aa"
      }
    },
    {
      "name": "Regex",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#B464A4",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Escape Sequences",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#a29bfe"
      }
    },
    {
      "name": "Type Parameters",
      "scope": [
        "entity.name.type.parameter"
      ],
      "settings": {
        "foreground": "#a29bfe"
      }
    },
    {
      "name": "Enums",
      "scope": [
        "entity.name.enum"
      ],
      "settings": {
        "foreground": "#a29bfe"
      }
    },
    {
      "name": "Interfaces",
      "scope": [
        "entity.name.interface"
      ],
      "settings": {
        "foreground": "#7dd3fc",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Namespaces",
      "scope": [
        "entity.name.namespace"
      ],
      "settings": {
        "foreground": "#9a98aa"
      }
    },
    {
      "name": "Language Constants",
      "scope": [
        "constant.language"
      ],
      "settings": {
        "foreground": "#a29bfe"
      }
    },
    {
      "name": "Punctuation - Structural",
      "scope": [
        "punctuation.section.block",
        "punctuation.section.embedded",
        "punctuation.section.class",
        "punctuation.section.method",
        "punctuation.definition.parameters",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#9a98aa"
      }
    },
    {
      "name": "HTML/XML/JSX Tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#7dd3fc"
      }
    },
    {
      "name": "HTML/XML/JSX Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#a29bfe",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Documentation Comments",
      "scope": [
        "comment.block.documentation",
        "comment.line.documentation"
      ],
      "settings": {
        "foreground": "#9a98aa",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Documentation Keywords/Tags",
      "scope": [
        "keyword.other.documentation"
      ],
      "settings": {
        "foreground": "#6a688a",
        "fontStyle": "italic bold"
      }
    },
    {
      "name": "Invalid or Deprecated",
      "scope": [
        "invalid",
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#ff6b81",
        "fontStyle": "italic underline"
      }
    },
    {
      "name": "Markdown Headings",
      "scope": "heading.markup.md",
      "settings": {
        "foreground": "#a29bfe",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Bold",
      "scope": "markup.bold.md",
      "settings": {
        "foreground": "#e5e0ff",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Italic",
      "scope": "markup.italic.md",
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown Links",
      "scope": "string.other.link.title.markdown",
      "settings": {
        "foreground": "#7dd3fc",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markdown Code Blocks",
      "scope": [
        "markup.fenced_code_block.md",
        "markup.inline.raw.string.markdown"
      ],
      "settings": {
        "foreground": "#a29bfe"
      }
    },
    {
      "name": "Jupyter Magic Commands",
      "scope": "keyword.control.ipython",
      "settings": {
        "foreground": "#c5a5ff",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Jupyter Notebook Comments",
      "scope": "comment.line.number-sign.python",
      "settings": {
        "foreground": "#7dd3fc",
        "fontStyle": "italic"
      }
    }
  ]
}