  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#a5b5b6",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings, Constants",
      "scope": [
        "string",
        "constant"
      ],
      "settings": {
        "foreground": "#B464A4"
      }
    },
    {
      "name": "Keywords, Storage Types",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#9c8af6",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Classes, Types, Structs",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "support.class"
      ],
      "settings": {
        "foreground": "#38bdf8",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Functions & Methods",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#38bdf8"
      }
    },
    {
      "name": "Variables & Parameters",
      "scope": [
        "variable"
      ],
      "settings": {
        "foreground": "#3c4e60"
      }
    },
    {
      "name": "Object Keys, Property Names",
      "scope": [
        "meta.object-literal.key",
        "support.type.property-name",
        "variable.other.property"
      ],
      "settings": {
        "foreground": "#9c8af6"
      }
    },
    {
      "name": "Variable Parameters",
      "scope": "variable.parameter",
      "settings": {
        "foreground": "#3c4e60",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Punctuation - General",
      "scope": "punctuation",
      "settings": {
        "foreground": "#a5b5b6"
      }
    },
    {
      "name": "Punctuation - Accessors",
      "scope": [
        "punctuation.accessor",
        "punctuation.separator.dot",
        "punctuation.separator.namespace"
      ],
      "settings": {
        "foreground": "#3c4e60"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#9c8af6"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#8f9d9e"
      }
    },
    {
      "name": "Regex",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#B464A4",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Escape Sequences",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#9c8af6"
      }
    },
    {
      "name": "Type Parameters",
      "scope": [
        "entity.name.type.parameter"
      ],
      "settings": {
        "foreground": "#9c8af6"
      }
    },
    {
      "name": "Enums",
      "scope": [
        "entity.name.enum"
      ],
      "settings": {
        "foreground": "#9c8af6"
      }
    },
    {
      "name": "Interfaces",
      "scope": [
        "entity.name.interface"
      ],
      "settings": {
        "foreground": "#38bdf8",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Namespaces",
      "scope": [
        "entity.name.namespace"
      ],
      "settings": {
        "foreground": "#8f9d9e"
      }
    },
    {
      "name": "Language Constants",
      "scope": [
        "constant.language"
      ],
      "settings": {
        "foreground": "#9c8af6"
      }
    },
    {
      "name": "Punctuation - Structural",
      "scope": [
        "punctuation.section.block",
        "punctuation.section.embedded",
        "punctuation.section.class",
        "punctuation.section.method",
        "punctuation.definition.parameters",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#8f9d9e"
      }
    },
    {
      "name": "HTML/XML/JSX Tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#38bdf8"
      }
    },
    {
      "name": "HTML/XML/JSX Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#9c8af6",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Documentation Comments",
      "scope": [
        "comment.block.documentation",
        "comment.line.documentation"
      ],
      "settings": {
        "foreground": "#8f9d9e",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Documentation Keywords/Tags",
      "scope": [
        "keyword.other.documentation"
      ],
      "settings": {
        "foreground": "#a5b5b6",
        "fontStyle": "italic bold"
      }
    },
    {
      "name": "Invalid or Deprecated",
      "scope": [
        "invalid",
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#d0493b",
        "fontStyle": "italic underline"
      }
    },
    {
      "name": "Markdown Headings",
      "scope": "heading.markup.md",
      "settings": {
        "foreground": "#9c8af6",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Bold",
      "scope": "markup.bold.md",
      "settings": {
        "foreground": "#3c4e60",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Italic",
      "scope": "markup.italic.md",
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown Links",
      "scope": "string.other.link.title.markdown",
      "settings": {
        "foreground": "#38bdf8",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markdown Code Blocks",
      "scope": [
        "markup.fenced_code_block.md",
        "markup.inline.raw.string.markdown"
      ],
      "settings": {
        "foreground": "#9c8af6"
      }
    },
    {
      "name": "Jupyter Magic Commands",
      "scope": "keyword.control.ipython",
      "settings": {
        "foreground": "#c5a5ff",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Jupyter Notebook Comments",
      "scope": "comment.line.number-sign.python",
      "settings": {
        "foreground": "#38bdf8",
        "fontStyle": "italic"
      }
    }
  ]
}